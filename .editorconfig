# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
max_line_length = 120

# Markdown files
[*.md]
max_line_length = 200

# JSON Lines: one record per line by definition, so a column limit cannot be
# satisfied without corrupting the format. Used by the audit findings ledger.
[*.jsonl]
max_line_length = off
